{
 "elemod": 2,
 "id": "tonefx",
 "version": "4.3b",
 "title": "Tone+FX",
 "description": "Tone+FX 4.3b by Digital Alchemy DSP (github.com/DigiAlchemydsp/RingTone), ported from its original FM-groovebox version: a master effect suite on every output: main, headphones and USB. Master ring modulator, a low-shelf/high-shelf master EQ (TILT), a Crunch/Redux lo-fi stage (REDUX / CRUNCH), a wavefolder with a continuous CLEAN/MUD/DIST/TRSH fold type, a five-mode modulation insert (PITCH: WOB / SHFT, STEREO: FLAN / PAN / WIDE), an output meter and a soft output ceiling. Seven pages after the stock master pages (FUNC+LFO; LEFT/RIGHT rotate the pages): DIGI RING, FOLD, TILT, CRUSH, PITCH, STEREO and DELAYS. UP from any of them opens the PERFORM tree: PERFORM and STUTTER. PERFORM is the eight-knob momentary trig-pad page; STUTTER freezes and loops the finished master mix at the selected tempo subdivision. Settings save and reload with the pattern (reserved MIDI track 8 on channel 16; \"DGX4\"), so they survive a pattern switch, a project load and a power cycle. The FX answer incoming MIDI CC. The unit starts with its own intro (no boot splash).",
 "category": "Sound",
 "author": "Digital Alchemy DSP (DT1 port: gdeo607)",
 "license": "GPL-2.0-or-later",
 "target": {
  "device": "digitakt-mk1",
  "product": "Digitakt mk1",
  "os": "1.54",
  "syx_sha256": "f78ba80fa7b1da5fb0e1ff61ad61e9e71aafe79f4364fc49679f3651353e3cf6",
  "section3_sha256": "5c58bf9e3949ef09977c5fc007a61e8d026931f67f1621238379dfb8ee4d31a2",
  "section3_len": 2479680
 },
