{
 "elemod": 2,
 "id": "tonefx",
 "version": "2.3c",
 "title": "Tone+FX",
 "description": "The Tone+FX suite as one elemod: master ring modulator (digiring), tone-tilt EQ (digieq), wavefolder (digifold), output meter (digimeter) and the DIGI FX / DIGI FOLD-EQ master pages with all their controls (digictl). Settings are stored per pattern and the FX respond to incoming MIDI CC. It REQUIRES the core (core-dn1) and does not include it, so it combines with any other elekloader mods.",
 "category": "Sound",
 "author": "Digital Alchemy DSP",
 "license": "GPL-2.0-or-later",
 "target": {
  "device": "digitone-mk1",
  "product": "Digitone mk1",
  "os": "1.43",
