{
 "elemod": 2,
 "id": "tonefx",
 "version": "3.1h",
 "title": "Tone+FX",
 "description": "The Tone+FX suite as one elemod: master ring modulator (digiring), a low-shelf/high-shelf master EQ (digieq), a wavefolder with a continuous CLEAN/MUD/DIST/TRSH fold type and an internal hard-clip overdrive on DIST/TRSH (digifold), a Crunch/Redux lo-fi stage (digicrush), a five-mode modulation insert WOB/SHFT/FLAN/PAN/WIDE (digiwave), output meter (digimeter) and the DIGI RING / DIGI FOLD / DIGI TILT / DIGI CRUSH / DIGI WAVE master pages with all their controls (digictl), plus the TONE+FX boot splash (tonesplash: an animated wordmark drawn at the intro, one of three animations per boot). Settings are stored per pattern and the FX respond to incoming MIDI CC. It REQUIRES the core (core-dn1) and does not include it, so it combines with any other elekloader mods.",
 "category": "Sound",
 "author": "Digital Alchemy DSP",
 "license": "GPL-2.0-or-later",
 "target": {
  "device": "digitone-mk1",
  "product": "Digitone mk1",
  "os": "1.43",
  "syx_sha256": "c5a54cc05b921f2e4bd814834c5365c2a5aa01d7772a9a2961fac1c3095bf9aa",
